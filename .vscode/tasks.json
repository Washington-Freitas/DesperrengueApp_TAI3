{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: pub get",
      "type": "shell",
      "command": "flutter pub get",
      "options": { "cwd": "${workspaceFolder}/app" },
      "problemMatcher": []
    },
    {
      "label": "Flutter: analyze",
      "type": "shell",
      "command": "flutter analyze",
      "options": { "cwd": "${workspaceFolder}/app" },
      "problemMatcher": []
    },
    {
      "label": "Flutter: test",
      "type": "shell",
      "command": "flutter test",
      "options": { "cwd": "${workspaceFolder}/app" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Android: iniciar emulador Pixel_8",
      "type": "shell",
      "command": "flutter emulators --launch Pixel_8",
      "problemMatcher": []
    },
    {
      "label": "Android Studio: abrir projeto app/",
      "type": "shell",
      "command": "& 'C:\\Program Files\\Android\\Android Studio\\bin\\studio64.exe' '${workspaceFolder}\\app'",
      "problemMatcher": []
    }
  ]
}
